{
  "name": "newonott",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Every new release, every platform, one page.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/build-seo.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit false --emitDeclarationOnly false --pretty",
    "refresh": "node scripts/fetch-releases.mjs && node scripts/enrich-releases.mjs && node scripts/fetch-logos.mjs",
    "build:single": "npm run build && node scripts/build-single.mjs",
    "enrich": "node scripts/enrich-releases.mjs",
    "logos": "node scripts/fetch-logos.mjs",
    "brand-marks": "node scripts/build-brand-marks.mjs",
    "providers": "node scripts/find-providers.mjs",
    "og": "node scripts/build-og.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.1.1",
    "simple-icons": "^16.29.0",
    "typescript": "^5.6.3",
    "vite": "^8.2.2"
  }
}
